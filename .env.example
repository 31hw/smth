# SMTH Music — environment configuration (copy to .env or export in shell)
# All of these are optional; sane defaults exist for a local setup.

# Bind address / port for the dev server
SMTH_HOST=127.0.0.1
SMTH_PORT=5000

# Secret key for session signing. Auto-generated on first boot if unset.
# SMTH_SECRET_KEY=

# Maximum upload size in megabytes
SMTH_MAX_UPLOAD_MB=50

# Disable public registrations (admin-only invite flow not yet implemented)
SMTH_REGISTRATION_OPEN=1

# Number of tracks per page on the home grid (0 = all)
SMTH_PAGE_SIZE=60
