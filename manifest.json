{
  "manifest_version": 3,
  "name": "ROBLOX Classic Overlay",
  "version": "1.0.0",
  "description": "Restyles Roblox with a 2016 or 2019 inspired interface while preserving the live website.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.roblox.com/*"],
  "action": {"default_popup": "popup.html", "default_title": "Classic Roblox Overlay", "default_icon": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"}},
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "content_scripts": [{
    "matches": ["https://*.roblox.com/*"],
    "exclude_matches": ["https://create.roblox.com/*"],
    "css": ["classic.css"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
